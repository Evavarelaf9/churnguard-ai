# Copie para .env e ajuste. Nunca versione o .env real.
# ---------------------------------------------------------------------------
# Banco (Docker Compose e execução local)
POSTGRES_USER=churnguard
POSTGRES_PASSWORD=churnguard
POSTGRES_DB=churnguard
DATABASE_URL=postgresql+psycopg://churnguard:churnguard@localhost:5432/churnguard

# Data "de hoje" no universo sintético do projeto. Em produção, remova esta linha para usar a data do sistema.
REFERENCE_DATE=2026-09-30

# Chaves de API: chave:usuario, separadas por vírgula. Vazio = autenticação desativada (apenas dev local).
# No Docker Compose, PANEL_API_KEY deve ser uma das chaves (o Nginx a injeta; o navegador nunca a vê).
API_KEYS=
PANEL_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Portas publicadas pelo Docker Compose
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432
